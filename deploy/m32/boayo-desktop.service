[Unit]
Description=BoAYO gaze-first spherical desktop
Requires=bosio-window-manager.service
After=bosio-window-manager.service

[Service]
Type=simple
User=xilinx
Group=xilinx
WorkingDirectory=/home/xilinx/bosio_boayo_m32_20261017/boayo
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/xilinx/bosio_boayo_m32_20261017
Environment=PYTHON=/usr/local/share/pynq-venv/bin/python3
ExecStartPre=/usr/local/share/pynq-venv/bin/python3 /home/xilinx/bosio_boayo_m32_20261017/boayo/wait_for_bosio.py
ExecStart=/usr/local/share/pynq-venv/bin/python3 -u /home/xilinx/bosio_boayo_m32_20261017/boayo/boayo_native_desktop.py --launcher --apps /home/xilinx/bosio_boayo_m32_20261017/boayo/apps.json
Restart=always
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
